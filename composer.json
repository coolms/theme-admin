{
    "name": "coolms/theme-admin",
    "description": "The CoolMS administration SPA, built with Angular",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "CoolMS Team"
        }
    ],
    "require": {
        "coolms/core": "^2.0",
        "coolms/document-fonts": "^0.1@dev",
        "php": ">=8.5",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/routing": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\ThemeAdmin\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "id": "coolms/theme-admin",
            "allow-contrib": false
        },
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\ThemeAdmin\\Tests\\": "tests/"
        }
    }
}
