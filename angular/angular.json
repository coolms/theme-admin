{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "coolms-admin": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css",
          "standalone": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "coolms-admin",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "../public",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "/assets/pdfjs/"
              },
              {
                // ⚠️ BROWSER-SUPPORT DECISION, 2026-09-04. Do not widen this
                // back to the whole directory without re-reading it.
                //
                // The viewer ships four builds of each of its viewer, worker
                // and sandbox: modern, modern-minified, es5 and es5-minified.
                // Copying the directory wholesale shipped all of them -- 14 MB
                // of which a browser fetches at most 2.9 MB -- because nothing
                // here selected one and the library default decided.
                //
                // What actually loads:
                //   pdfDefaultOptions._internalFilenameSuffix is ".min", and
                //   the library marks it "don't modify this". So the
                //   NON-minified twins can never be the file that is fetched.
                //
                //   needsES5 is (_isIE11 || /Edge\/\d./ user agent || no
                //   ReadableStream). This app targets ES2022 and browserslist
                //   resolves to chrome 109+, firefox 140+, edge 149+,
                //   ios_saf 26.4+ -- none of which is IE11, none of which
                //   lacks ReadableStream, and Chromium Edge sends "Edg/" not
                //   "Edge/". So the es5 branch is unreachable from a browser
                //   that can run this admin at all.
                //
                // If the baseline ever grows a browser that needs es5, this
                // ignore list is what has to change, and the admin will fail
                // by 404 on the worker rather than quietly.
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/assets/",
                "output": "/assets/",
                "ignore": [
                  "**/viewer-*[0-9].mjs",
                  "**/pdf.worker-*[0-9].mjs",
                  "**/pdf.sandbox-*[0-9].mjs"
                ]
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css",
              "node_modules/@xterm/xterm/css/xterm.css",
              "node_modules/bootstrap-icons/font/bootstrap-icons.min.css",
              "node_modules/katex/dist/katex.min.css",
              "../../designer/src/styles/coolms-designer.css",
              "node_modules/fullcalendar/skeleton.css",
              "node_modules/fullcalendar/themes/classic/theme.css",
              "src/styles.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "tui-image-editor",
              "tui-color-picker",
              "jszip",
              "katex"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "7MB",
                  "maximumError": "10MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "//": [
            "esbuild-based karma builder, NOT @angular-devkit/build-angular:karma.",
            "That one is webpack, and webpack sets no `resolve.extensionAlias`, so it",
            "cannot follow @coolms/document-engine's ESM-correct './x.js' specifiers",
            "back to the .ts sources the `paths` mapping points at. Any spec whose",
            "import graph reached the engine -- which is every DynamicFormComponent,",
            "hence My Profile -- failed the WHOLE suite at build time and nothing ran.",
            "This builder shares the `build` target's esbuild resolution, so `test`",
            "and `build` now agree by construction instead of by coincidence.",
            "",
            "Spec discovery is PROJECT-ROOT ONLY, and the builder's `include` will not",
            "climb above it -- an `../../core-angular/**` glob is accepted and silently",
            "matches nothing. core's specs are therefore imported by",
            "src/core-angular-specs.spec.ts; without it the suite drops 656 -> 623 and",
            "still reports SUCCESS."
          ],
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css",
              "node_modules/bootstrap-icons/font/bootstrap-icons.min.css",
              "src/styles.scss"
            ],
            "scripts": []
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "servePath": "/admin/"
          },
          "configurations": {
            "production": {
              "buildTarget": "coolms-admin:build:production"
            },
            "development": {
              "buildTarget": "coolms-admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
